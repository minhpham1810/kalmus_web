# Server Configuration
PORT=5000

# Directory Configuration
# These paths should be on a shared filesystem accessible by compute nodes
UPLOAD_DIR=/path/to/shared/uploads
RESULTS_DIR=/path/to/shared/results
SLURM_SCRIPTS_DIR=./slurm_scripts

# Python Environment
# Command to activate the Python environment on compute nodes
# Examples:
#   - Conda: source activate kalmus_env
#   - Virtualenv: source /path/to/kalmus_env/bin/activate
#   - Module: module load python/3.9 && source ~/kalmus_env/bin/activate
PYTHON_ENV=source ~/kalmus_env/bin/activate

# KALMUS Processor Script
# Path to the kalmus_processor.py script on the shared filesystem
KALMUS_SCRIPT=/path/to/kalmus_processor.py

# SLURM Configuration (optional overrides)
DEFAULT_PARTITION=short
DEFAULT_MEMORY=16GB
DEFAULT_CPUS=4
DEFAULT_TIME=01:00:00
