# KALMUS SLURM Configuration Template
# Copy this file to .env and modify for your environment

# Work directory on shared filesystem (accessible from all compute nodes)
# This is where uploaded videos and results will be stored
KALMUS_WORK_DIR=/home/yourusername/kalmus_jobs

# Path to Python virtual environment
# Must be on shared filesystem visible to compute nodes
KALMUS_VENV_PATH=/home/yourusername/kalmus_venv

# Email for SLURM job notifications
# You'll receive emails when jobs complete or fail
KALMUS_USER_EMAIL=your.email@bucknell.edu

# Flask environment
FLASK_ENV=production

# Optional: Customize SLURM defaults
# KALMUS_DEFAULT_PARTITION=short
# KALMUS_DEFAULT_CORES=4
# KALMUS_DEFAULT_MEMORY=16384
