# Next.js API Base URL (optional, for when running behind a proxy)
NEXT_PUBLIC_API_BASE_URL=

# SLURM Configuration
UPLOAD_DIR=/shared/kalmus/uploads
RESULTS_DIR=/shared/kalmus/results
SCRIPTS_DIR=/shared/kalmus/scripts
PYTHON_ENV=source ~/kalmus_env/bin/activate
KALMUS_SCRIPT=/shared/kalmus/kalmus_processor.py
EMAIL_SCRIPT=/shared/kalmus/send_barcode_email.py

# Website URL for email links
# This is used in email notifications to generate links back to the results dashboard
# For production: https://your-domain.com
# For development: http://localhost:3000
WEBSITE_URL=http://localhost:3000

# Project root (Python scripts derive app/databases/films.db and results/ from this)
ROOT_DIR=/home/kalmus/kalmus

# SQLite films database (optional, defaults to /home/kalmus/kalmus/app/databases/films.db)
FILMS_DB_PATH=

# Where multi-file submission batches are tracked (optional, defaults to /tmp/kalmus-submission-batches)
SUBMISSION_BATCH_DIR=

# OMDB API key for movie metadata lookups (https://www.omdbapi.com/apikey.aspx)
OMDB_KEY=

# Admins (not read by any code yet)
ADMINS=

# HPC transfer settings (optional — only needed if using SSH2/SFTP instead of NFS direct write)
# HPC_HOST=
# HPC_USER=
# HPC_KEY_PATH=
# HPC_UPLOAD_DIR=
